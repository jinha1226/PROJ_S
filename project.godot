config_version=5

[application]
config/name="잿빛 원정 — 통합 프로토타입"
run/main_scene="res://expedition/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=1200
window/size/viewport_height=860
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.04, 0.055, 1)
